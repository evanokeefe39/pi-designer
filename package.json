{
	"name": "pi-designer",
	"version": "0.1.0",
	"description": "A pi coding-agent extension that generates design systems (color ramps, type and spacing scales) and exports design tokens for websites, reports, social carousels, and email newsletters.",
	"type": "module",
	"license": "MIT",
	"author": "Evan O'Keefe <evan.okeefe39@gmail.com>",
	"homepage": "https://github.com/evanokeefe39/pi-designer#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evanokeefe39/pi-designer.git"
	},
	"bugs": {
		"url": "https://github.com/evanokeefe39/pi-designer/issues"
	},
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"design-system",
		"design-tokens",
		"tailwind",
		"css-variables"
	],
	"pi": {
		"extensions": ["./src/index.ts"],
		"skills": ["./skills/"]
	},
	"files": ["src", "skills", "examples", "README.md", "LICENSE"],
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"typebox": "^1.1.38"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.80.0",
		"@earendil-works/pi-coding-agent": ">=0.80.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@earendil-works/pi-ai": "^0.80.2",
		"@earendil-works/pi-coding-agent": "^0.80.2",
		"@types/node": "^22.0.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	},
	"engines": {
		"node": ">=20"
	}
}
